# ============================================================
# CARINA CORE - Environment Variables (12-Factor App)
# ============================================================
# Cópia deste arquivo deve ser renomeada para '.env' na máquina local.
# O arquivo '.env' não deve ser comitado no controle de versão (Git).

# --- Database Secrets ---
# Senhas e credenciais do banco de dados (ex: PostgreSQL)
CARINA_DB_USER=seu_usuario_aqui
CARINA_DB_PASSWORD=sua_senha_super_secreta_aqui
CARINA_DB_HOST=localhost
CARINA_DB_PORT=5432
CARINA_DB_NAME=banco_de_dados_noxfort
CARINA_DB_SCHEMA=schema_carina

# --- SNMP / Hardware Secrets ---
# Chave de leitura/escrita para controladores semafóricos (NTCIP/UTMC)
CARINA_SNMP_COMMUNITY=public

# --- MQTT / Cloud Secrets ---
# Credenciais para exportar dados ou monitoramento externo
CARINA_MQTT_HOST=192.168.1.100
CARINA_MQTT_PORT=1883
CARINA_MQTT_USER=
CARINA_MQTT_PASSWORD=
