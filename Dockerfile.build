# ==============================================================================
# CARINA .deb Builder — Sterile Docker Environment
# Base: Ubuntu 22.04 (glibc 2.35) for maximum compatibility
#
# Usage:
#   docker build -f Dockerfile.build -t carina-builder .
#   docker run --rm -v $(pwd)/dist:/output carina-builder
# ==============================================================================

FROM ubuntu:22.04 AS builder

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# ─────────────────────────────────────────────────────────────────────────────
# 1. System dependencies — base tools + GPG (needed for PPA key import)
# ─────────────────────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    gpg \
    gpg-agent \
    ca-certificates \
    curl \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.12 \
    python3.12-venv \
    python3.12-dev \
    python3-pip \
    build-essential \
    patchelf \
    # Graphics / UI runtime deps (for Flet and matplotlib)
    libgl1-mesa-glx \
    libglib2.0-0 \
    libxkbcommon0 \
    libfontconfig1 \
    libxrender1 \
    libxext6 \
    libx11-6 \
    libdbus-1-3 \
    libegl1 \
    libxcb-cursor0 \
    libxcb-icccm4 \
    libxcb-keysyms1 \
    libxcb-shape0 \
    # Debian packaging
    dpkg-dev \
    fakeroot \
    # Cleanup
    && rm -rf /var/lib/apt/lists/*

# ─────────────────────────────────────────────────────────────────────────────
# 2. Create isolated Python venv
# ─────────────────────────────────────────────────────────────────────────────
RUN python3.12 -m venv /opt/buildvenv
ENV PATH="/opt/buildvenv/bin:$PATH"
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# ─────────────────────────────────────────────────────────────────────────────
# 3. Install Python dependencies (ALL from venv freeze)
# ─────────────────────────────────────────────────────────────────────────────
COPY build-requirements.txt /tmp/build-requirements.txt
RUN pip install --no-cache-dir -r /tmp/build-requirements.txt

# ─────────────────────────────────────────────────────────────────────────────
# 4. Copy project source
# ─────────────────────────────────────────────────────────────────────────────
WORKDIR /build
COPY carina.py carina.spec ./
COPY src/ src/
COPY proto/ proto/
COPY ui/ ui/
COPY config/ config/
COPY Model_Vault/ Model_Vault/
COPY debian/ debian/

# ─────────────────────────────────────────────────────────────────────────────
# 5. Build with PyInstaller
# ─────────────────────────────────────────────────────────────────────────────
RUN pyinstaller --noconfirm --log-level INFO carina.spec

# ─────────────────────────────────────────────────────────────────────────────
# 6. Verify critical modules are in the bundle
# ─────────────────────────────────────────────────────────────────────────────
RUN echo "=== Verifying bundled modules ===" && \
    for mod in torch grpc flet prometheus_client psycopg2 paho pysnmp nvidia xxhash pystray; do \
    if ls dist/carina/_internal/ | grep -qi "$mod"; then \
    echo "  ✓ $mod found"; \
    else \
    echo "  ✗ $mod MISSING — build may be incomplete" >&2; \
    fi; \
    done

# ─────────────────────────────────────────────────────────────────────────────
# 7. Assemble .deb package
# ─────────────────────────────────────────────────────────────────────────────
RUN mkdir -p /deb-root/opt/carina \
    && cp -a dist/carina/* /deb-root/opt/carina/ \
    # DEBIAN control files
    && mkdir -p /deb-root/DEBIAN \
    && cp debian/control /deb-root/DEBIAN/control \
    && cp debian/postinst /deb-root/DEBIAN/postinst \
    && chmod 0755 /deb-root/DEBIAN/postinst \
    # .desktop file
    && mkdir -p /deb-root/usr/share/applications \
    && cp debian/carina.desktop /deb-root/usr/share/applications/carina.desktop \
    # Icon for the menu
    && mkdir -p /deb-root/usr/share/icons/hicolor/256x256/apps \
    && cp ui/assets/images/logo.png /deb-root/usr/share/icons/hicolor/256x256/apps/carina.png \
    # Symlink to /usr/local/bin for PATH access
    && mkdir -p /deb-root/usr/local/bin \
    && ln -sf /opt/carina/carina /deb-root/usr/local/bin/carina

# Build the .deb
RUN dpkg-deb --build /deb-root /tmp/carina_1.0.0_amd64.deb

# ─────────────────────────────────────────────────────────────────────────────
# 8. Verify .deb
# ─────────────────────────────────────────────────────────────────────────────
RUN echo "=== .deb Info ===" && dpkg-deb --info /tmp/carina_1.0.0_amd64.deb \
    && echo "=== .deb Size ===" && du -sh /tmp/carina_1.0.0_amd64.deb \
    && echo "=== Checking no NVIDIA kernel drivers ===" \
    && if dpkg-deb --contents /tmp/carina_1.0.0_amd64.deb | grep -i "nvidia-driver"; then \
    echo "WARNING: NVIDIA kernel drivers found in .deb!" >&2; \
    else \
    echo "  ✓ No NVIDIA kernel drivers in .deb (CUDA runtime libs are OK)"; \
    fi

# ─────────────────────────────────────────────────────────────────────────────
# 9. Output stage — copy .deb to mounted volume
# ─────────────────────────────────────────────────────────────────────────────
CMD ["cp", "/tmp/carina_1.0.0_amd64.deb", "/output/carina_1.0.0_amd64.deb"]
